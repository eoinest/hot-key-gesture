{
  "name": "hot-key-gesture",
  "version": "0.1.0",
  "description": "Control your computer with hand gestures — webcam gestures mapped to global hotkeys, fully local.",
  "type": "module",
  "main": "./out/main/index.js",
  "private": true,
  "author": "Ernest McCarter",
  "license": "MIT",
  "scripts": {
    "setup-assets": "node scripts/setup-assets.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/setup-assets.mjs && node scripts/build-helper.mjs",
    "smoke": "npm run build && electron . --smoke",
    "build-helper": "node scripts/build-helper.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
